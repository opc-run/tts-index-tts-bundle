# Generated by the installer (index-tts source + isolated venv).
# The folder itself must not be pre-created: `git clone` needs an empty dir.
index-tts/

# Private tooling / python / caches installed by the scripts.
# Folders are PRE-CREATED in the bundle, so keep their READMEs in git.
tools/*
!tools/README.md
!tools/package-skill.py
python/*
!python/README.md
cache/*
!cache/README.md
output/*
!output/README.md
*.log

# Install state (machine-specific paths)
.install-state.json

# Skill build artifact: regenerated by `python tools/package-skill.py`
skills/dist/

# Model checkpoints: large, not committed. Keep only the folder's README.
checkpoints/*
!checkpoints/README.md

# OS noise
Thumbs.db
.DS_Store
